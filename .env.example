# --- Database (required) ---
POSTGRES_DB=caos
POSTGRES_USER=caos
POSTGRES_PASSWORD=replace-with-strong-password
# For local non-Docker dev: DATABASE_URL=sqlite:///./caos.db
DATABASE_URL=postgresql+psycopg://caos:replace-with-strong-password@db:5432/caos

# --- Security (required) ---
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
# Access token lifetime; refresh rotates server-side sessions
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- URLs ---
CORS_ORIGINS=http://localhost:5173,https://caos.thinkred.ru
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1

# --- OAuth: Stepik (optional) ---
STEPIK_CLIENT_ID=
STEPIK_CLIENT_SECRET=
STEPIK_REDIRECT_URI=http://localhost:8000/api/v1/auth/stepik/callback
STEPIK_COURSE_IDS=288738,288774,285340

# --- OAuth: Google (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Email verification / password reset (optional; empty = letters are skipped in dev) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@caos.thinkred.ru

# --- AI recommendations (optional; empty = stub mode without a provider) ---
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Misc ---
DEBUG=false  # true enables /docs Swagger locally; keep false in production
REDIS_PASSWORD=replace-with-strong-redis-password
